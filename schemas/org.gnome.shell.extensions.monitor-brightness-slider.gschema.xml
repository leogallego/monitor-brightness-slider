<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="monitor-brightness-slider">
  <schema id="org.gnome.shell.extensions.monitor-brightness-slider"
    path="/org/gnome/shell/extensions/monitor-brightness-slider/">
    <key type="as" name="monitor-screen-brightness-up">
      <default><![CDATA[['<Control>XF86MonBrightnessUp']]]></default>
      <summary>Monitor Brightness Up Keybinding</summary>
    </key>
    <key type="as" name="monitor-screen-brightness-down">
      <default><![CDATA[['<Control>XF86MonBrightnessDown']]]></default>
      <summary>Monitor Brightness Down Keybinding</summary>
    </key>
    <key type="u" name="ddcutil-retries">
      <range min="1" max="10" />
      <default>3</default>
      <summary>How many times to call `ddcutil' to find monitors, to improve unreliable DDC.</summary>
    </key>
  </schema>
</schemalist>
